}

for i, name in ipairs(names) do
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1,-24,0,43)
    button.Position = UDim2.new(0,12,0,49+(i-1)*49)
    button.BackgroundColor3 = Color3.fromRGB(55,35,75)
