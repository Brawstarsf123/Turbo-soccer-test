-- Find the ball
local function findBall()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()

            if n == "ball"
                or n == "soccerball"
                or n == "gameball" then
                return obj
            end
        end
    end

    return nil
end

