local function addToggle(name, index)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 38)
    button.Position = UDim2.new(0, 12, 0, 48 + (index-1)*43)
    button.BackgroundColor3 = Color3.fromRGB(55, 35, 75)
    button.TextColor3 = Color3.new(1,1,1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 13
    button.Parent = frame

    local function update()
        button.Text = name .. ": " ..
            (toggles[name] and "ON" or "OFF")
        button.BackgroundColor3 = toggles[name]
            and Color3.fromRGB(115, 40, 190)
            or Color3.fromRGB(55, 35, 75)
    end

    button.MouseButton1Click:Connect(function()
        toggles[name] = not toggles[name]
        update()
        status.Text = name .. " " ..
            (toggles[name] and "enabled" or "disabled")
    end)

    update()
end

local index = 0
for name in pairs(toggles) do
    index += 1
    addToggle(name, index)
end

close.MouseButton1Click:Connect(function()
    frame.Visible = false
    mini.Visible = true
end)

mini.MouseButton1Click:Connect(function()
    frame.Visible = true
    mini.Visible = false
end)

-- Best-effort ball discovery.
local function findBall()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n == "ball" or n == "soccerball"
                or n == "gameball" then
                return obj
            end
        end
    end
end

local marker = Instance.new("Part")
marker.Name = "NeonBallPrediction"
marker.Shape = Enum.PartType.Ball
marker.Size = Vector3.new(1.5, 1.5, 1.5)
marker.Anchored = true
marker.CanCollide = false
marker.Material = Enum.Material.Neon
marker.Color = Color3.fromRGB(190, 60, 255)
marker.Transparency = 0.3
marker.Parent = Workspace

local label = Instance.new("BillboardGui")
label.Size = UDim2.fromOffset(180, 35)
label.AlwaysOnTop = true
label.Enabled = false
label.Parent = marker

local text = Instance.new("TextLabel")
text.Size = UDim2.fromScale(1, 1)
text.BackgroundTransparency = 1
text.TextColor3 = Color3.new(1,1,1)
text.TextStrokeTransparency = 0
text.Text = "BALL"
text.Parent = label

local connection
connection = RunService.Heartbeat:Connect(function()
    local ball = findBall()

    if not ball then
        label.Enabled = false
        marker.Transparency = 1
        return
    end

    if toggles["Ball Tracker"] then
        label.Enabled = true
        marker.Transparency = 1
        marker.CFrame = ball.CFrame
    else
        label.Enabled = false
    end

    if toggles["Ball Prediction"] or
       toggles["Landing Predictor"] then
        marker.Transparency = 0.3
        local velocity = ball.AssemblyLinearVelocity
        local timeAhead = 0.6

        if toggles["Landing Predictor"] then
            timeAhead = 1.2
        end

        local predicted = ball.Position +
            velocity * timeAhead +
            Vector3.new(0, -Workspace.Gravity *
                timeAhead * timeAhead / 2, 0)

        marker.Position = predicted
    else
        marker.Transparency = 1
    end
end)

print("NEON TURBO SOCCER V1 loaded!")
