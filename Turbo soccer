local function hidePrediction()
    prediction.Transparency = 1
    beam.Enabled = false
end

local function hideLanding()
    landing.Transparency = 1
    landingLabel.Enabled = false
end

local function getGround(position, currentBall)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local excluded = {currentBall, prediction, landing}

    if player.Character then
        table.insert(excluded,player.Character)
    end

    params.FilterDescendantsInstances = excluded

    return Workspace:Raycast(
        position + Vector3.new(0,100,0),
        Vector3.new(0,-1000,0),
        params
    )
end

-- Main update
local connection

connection = RunService.Heartbeat:Connect(function(dt)
    scanTimer += dt

    if scanTimer >= 0.5 then
        scanTimer = 0

        if not ball or not ball.Parent then
            ball = findBall()
        end
    end

    if not ball or not ball.Parent then
        ballLabel.Enabled = false
        hidePrediction()
        hideLanding()
        status.Text = "Ball not found"
        return
    end

    local position = ball.Position
    local velocity = ball.AssemblyLinearVelocity
    local gravity = Workspace.Gravity

    local radius = math.max(
        ball.Size.X,
        ball.Size.Y,
        ball.Size.Z
    ) / 2

    -- 1. BALL TRACKER
    if toggles["Ball Tracker"] then
        ballLabel.Adornee = ball
        ballLabel.Enabled = true
    else
        ballLabel.Enabled = false
    end

    -- 2. BALL PREDICTION + LINE
    if toggles["Ball Prediction"] then
        local t = 0.65

        local future = position
            + velocity*t
            + Vector3.new(0,-0.5*gravity*t*t,0)

        prediction.Position = future
        prediction.Transparency = 0.2

        if lineStart.Parent ~= ball then
            lineStart.Parent = ball
        end

        beam.Enabled = true
    else
        hidePrediction()
    end

    -- 3. LANDING PREDICTOR
    if toggles["Landing Predictor"] then
        local ground = getGround(position,ball)

        if ground then
            local targetY = ground.Position.Y + radius
            local height = position.Y - targetY

            local discriminant =
                velocity.Y*velocity.Y + 2*gravity*height

            if height > 0.2 and discriminant >= 0 then
                local fallTime =
                    (velocity.Y + math.sqrt(discriminant))
                    / gravity

                if fallTime > 0.08 and fallTime < 15 then
                    local projected = position + Vector3.new(
                        velocity.X*fallTime,
                        0,
                        velocity.Z*fallTime
                    )

                    local landingGround = getGround(
                        projected + Vector3.new(0,20,0),
                        ball
                    )

                    local groundY = landingGround
                        and landingGround.Position.Y
                        or ground.Position.Y

                    local finalPosition = Vector3.new(
                        projected.X,
                        groundY + 0.12,
                        projected.Z
                    )

                    landing.CFrame =
                        CFrame.new(finalPosition)
                        * CFrame.Angles(0,0,math.rad(90))

                    landing.Transparency = 0.2
                    landingLabel.Enabled = true
                else
                    hideLanding()
                end
            else
                hideLanding()
            end
        else
            hideLanding()
        end
    else
        hideLanding()
    end

    status.Text = "Ball found | Speed: " ..
        math.floor(velocity.Magnitude)
end)

