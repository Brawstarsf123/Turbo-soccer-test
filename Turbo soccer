-- Raycast settings
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getGround(position, ball)
    local excluded = {ball}

    if player.Character then
        table.insert(excluded, player.Character)
    end

    rayParams.FilterDescendantsInstances = excluded

    local origin = position + Vector3.new(0, 150, 0)
    local direction = Vector3.new(0, -1200, 0)

    local result = Workspace:Raycast(
        origin,
        direction,
        rayParams
    )

    if result then
        return result.Position
    end

    return nil
end

-- Calculate approximate time until landing
local function getLandingTime(ball, groundPosition)
    local gravity = math.max(Workspace.Gravity, 1)
    local height = ball.Position.Y - groundPosition.Y
    local velocityY = ball.AssemblyLinearVelocity.Y

    if height <= 0.15 then
        return 0.8
    end

    local discriminant =
        velocityY * velocityY + 2 * gravity * height

    if discriminant < 0 then
        return 1.5
    end

    local time =
        (velocityY + math.sqrt(discriminant)) / gravity

    if time <= 0 then
        return 0.8
    end

    return math.clamp(time, 0.05, 8)
end

local function calculatePosition(ball, time)
    local velocity = ball.AssemblyLinearVelocity
    local gravity = Workspace.Gravity

    return ball.Position
        + velocity * time
        + Vector3.new(0, -0.5 * gravity * time * time, 0)
end

-- Update visuals
local updateTimer = 0

local connection
connection = RunService.Heartbeat:Connect(function(dt)
    updateTimer += dt

    if updateTimer < 0.025 then
        return
    end

    updateTimer = 0

    local ball = findBall()

    if not ball then
        tracker.Enabled = false
        predictionMarker.Transparency = 1
        landingCircle.Transparency = 1

        for _, part in ipairs(predictionParts) do
            part.Transparency = 1
        end

        status.Text = "Waiting for ball..."
        return
    end

    -- Ball tracker
    if toggles["Ball Tracker"] then
        tracker.Adornee = ball
        tracker.Enabled = true
        trackerText.Text = "⚽ BALL  |  " ..
            math.floor(ball.AssemblyLinearVelocity.Magnitude)
    else
        tracker.Enabled = false
    end

    local groundPosition = getGround(ball.Position, ball)

    if not groundPosition then
        landingCircle.Transparency = 1

        for _, part in ipairs(predictionParts) do
            part.Transparency = 1
        end

        return
    end

    local landingTime = getLandingTime(ball, groundPosition)

    -- Landing prediction
    if toggles["Landing Predictor"] then
        local landingPosition =
            calculatePosition(ball, landingTime)

        local groundAtLanding =
            getGround(landingPosition, ball)

        if groundAtLanding then
            landingCircle.CFrame =
                CFrame.new(
                    groundAtLanding + Vector3.new(0, 0.12, 0)
                ) * CFrame.Angles(0, 0, math.rad(90))

            landingCircle.Transparency = 0.12
        else
            landingCircle.Transparency = 1
        end
    else
        landingCircle.Transparency = 1
    end

    -- Curved ball trajectory
    if toggles["Ball Prediction"] then
        local flightTime = math.min(landingTime, 3.5)
        local previousPosition = ball.Position

        for i = 1, #predictionParts do
            local t = flightTime * (i / #predictionParts)
            local nextPosition = calculatePosition(ball, t)

            local part = predictionParts[i]
            local difference = nextPosition - previousPosition
            local length = difference.Magnitude

            if length > 0.01 then
                part.Size = Vector3.new(0.17, 0.17, length)
                part.CFrame = CFrame.lookAt(
                    (previousPosition + nextPosition) / 2,
                    nextPosition
                )
                part.Transparency = 0.08
            else
                part.Transparency = 1
            end

            previousPosition = nextPosition
        end

        local endPosition =
            calculatePosition(ball, flightTime)

        predictionMarker.Position = endPosition
        predictionMarker.Transparency = 0.2
    else
        predictionMarker.Transparency = 1

        for _, part in ipairs(predictionParts) do
            part.Transparency = 1
        end
    end

    status.Text = "Ball speed: " ..
        math.floor(ball.AssemblyLinearVelocity.Magnitude)
end)

